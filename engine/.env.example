# Même valeur que VOICE_ENGINE_TOKEN dans web/.env (générer avec : openssl rand -hex 32)
ENGINE_TOKEN=
# chatterbox = vrai modèle vocal ; fake = signal de test sans modèle
ENGINE_DRIVER=chatterbox
# Nombre de cœurs utilisés (0 = automatique)
ENGINE_THREADS=0
# Modèle de transcription : tiny, base, small (défaut), medium, large-v3. Plus gros = plus précis et plus lent.
ENGINE_WHISPER_MODEL=small
